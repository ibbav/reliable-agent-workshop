{
  "name": "reliable-agent-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -B -m unittest discover -s evaluation -p 'test_*.py' && python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "demo": "node evaluation/replay.mjs --spec examples/conference-assistant/evaluation.json",
    "demo:triage": "node evaluation/replay.mjs --spec examples/support-triage/evaluation.json",
    "dry-run": "node evaluation/run.mjs --spec examples/conference-assistant/evaluation.json",
    "plugins": "node evaluation/plugin-cli.mjs list",
    "plugin:new": "node evaluation/plugin-cli.mjs new",
    "bayes:setup": "node evaluation/bayesian.mjs setup",
    "bayes:demo": "node evaluation/bayesian.mjs demo",
    "bayes": "node evaluation/bayesian.mjs fit",
    "audit": "node scripts/audit-public.mjs . && python3 scripts/audit_artifacts.py ."
  }
}
